// Hillside's keyboard-driven wheel speed. This does not change the Toucan trackpad.
#define ZMK_POINTING_DEFAULT_SCRL_VAL 30

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/outputs.h>
#include <dt-bindings/zmk/pointing.h>
#include "toucan_36_layout.dtsi"

// toucan.dtsi uses layers 1/2 for scrolling and momentarily activates 4 on touch.
#define L_BASE  0
#define L_NAV   1
#define L_SYM   2
#define L_WM    3
#define L_MOUSE 4
#define L_NUM   5
#define L_ADJ   6
#define L_DRAG  7

// Keep the Backspace/Shift thumb tap-preferred.
&mt {
    flavor = "tap-preferred";
    tapping-term-ms = <170>;
    quick-tap-ms = <100>;
    require-prior-idle-ms = <80>;
};

&msc {
    acceleration-exponent = <2>;
    time-to-max-speed-ms = <800>;
    delay-ms = <200>;
};

/ {
    behaviors {
        // Finger mods resolve on the opposite hand's key-down, including thumbs.
        // No prior-idle or quick-tap gate: a chord can follow typing immediately.
        lmod: left_finger_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            hold-trigger-key-positions = <5 6 7 8 9  15 16 17 18 19  25 26 27 28 29  33 34 35>;
        };
        rmod: right_finger_mod {
            compatible = "zmk,behavior-hold-tap";
            #binding-cells = <2>;
            bindings = <&kp>, <&kp>;
            flavor = "hold-preferred";
            tapping-term-ms = <170>;
            hold-trigger-key-positions = <0 1 2 3 4  10 11 12 13 14  20 21 22 23 24  30 31 32>;
        };

        layer_off: layer_off {
            compatible = "zmk,behavior-toggle-layer";
            #binding-cells = <1>;
            toggle-mode = "off";
            display-name = "Leave layer";
        };
    };

    // Keep the synthetic button press independent of the pad's momentary MOU layer.
    macros {
        drag_on: drag_on {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_press &mkp LCLK &macro_tap &tog L_DRAG>;
        };
        drag_off: drag_off {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_release &mkp LCLK &macro_tap &layer_off L_DRAG>;
        };
        drag_cancel: drag_cancel {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            wait-ms = <0>;
            tap-ms = <0>;
            bindings = <&macro_release &mkp LCLK &macro_tap &layer_off L_DRAG &layer_off L_MOUSE>;
        };
    };

    // Three rows of 5+5 (0..29), then the six thumbs left to right (30..35).
    combos {
        compatible = "zmk,combos";

        combo_esc {
            key-positions = <11 12>; // R + S (same positions on SYM)
            bindings = <&kp ESC>;
            layers = <L_BASE L_SYM>;
        };
        // Left-only recovery if the peripheral cannot send a touch-up.
        combo_leave_mouse {
            key-positions = <11 12>; // R + S
            bindings = <&layer_off L_MOUSE>;
            layers = <L_MOUSE>;
        };
        combo_cancel_drag {
            key-positions = <11 12>; // R + S, even after lifting off the pad
            bindings = <&drag_cancel>;
            layers = <L_DRAG>;
        };
        combo_tab {
            key-positions = <2 1>; // F + W
            bindings = <&kp TAB>;
            layers = <L_BASE>;
        };
        combo_remove_word {
            key-positions = <7 8>; // U + Y
            bindings = <&kp LA(BACKSPACE)>;
            layers = <L_BASE>;
        };
        combo_control {
            key-positions = <31 34>; // SYM thumb + Enter thumb
            bindings = <&kp LEFT_CONTROL>;
            layers = <L_BASE>;
        };
        combo_left_click {
            key-positions = <13 12>; // T + S
            bindings = <&mkp LCLK>;
            layers = <L_BASE L_MOUSE>;
        };
        combo_right_click {
            key-positions = <3 2>; // P + F
            bindings = <&mkp RCLK>;
            layers = <L_BASE L_MOUSE>;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";
        tri_layer {
            if-layers = <L_NAV L_SYM>;
            then-layer = <L_ADJ>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            display-name = "BASE";
            bindings = <
                &kp Q        &kp W       &kp F     &kp P      &kp B              &kp J           &kp L      &kp U      &kp Y         &lt L_NUM KP_N0
                &kp A        &kp R       &kp S     &kp T      &kp G              &kp M           &kp N      &kp E      &kp I         &kp O
                &lmod LSHFT Z  &lmod LGUI X  &kp C     &kp D      &kp V              &kp K           &kp H      &kp COMMA  &rmod LGUI DOT  &rmod LSHFT MINUS
                                         &mo L_WM  &sl L_SYM  &lt L_NAV SPACE    &mt LSHFT BSPC  &kp ENTER  &kp RALT
            >;
        };

        nav {
            display-name = "NAV";
            bindings = <
                &kp N1                      &kp N2                     &kp N3             &kp N4           &kp N5        &kp N6        &kp N7        &kp N8        &kp N9     &kp N0
                &kp F5                      &msc SCRL_DOWN             &msc SCRL_DOWN     &msc SCRL_UP     &mkp RCLK     &kp LEFT      &kp DOWN      &kp UP        &kp RIGHT  &kp MINUS
                &lmod LSHFT C_BRIGHTNESS_DEC  &lmod LGUI C_BRIGHTNESS_INC  &kp C_VOLUME_DOWN  &kp C_VOLUME_UP  &kp K_MUTE    &out OUT_TOG  &bt BT_SEL 0  &bt BT_SEL 1  &trans     &bt BT_CLR
                                                                       &bootloader        &trans           &trans        &trans        &trans        &bootloader
            >;
        };

        sym {
            display-name = "SYM";
            bindings = <
                &kp EXCL       &kp AT          &kp HASH           &kp DOLLAR     &kp PERCENT    &kp LESS_THAN   &kp LEFT_BRACKET      &kp EQUAL  &kp RIGHT_BRACKET      &kp GREATER_THAN
                &kp QUESTION   &kp SQT         &kp DOUBLE_QUOTES  &kp SEMI       &kt TILDE      &kp LEFT_BRACE  &kp LEFT_PARENTHESIS  &kp COLON  &kp RIGHT_PARENTHESIS  &kp RIGHT_BRACE
                &kp BACKSLASH  &lmod LGUI CARET  &kp PIPE           &kp AMPERSAND  &kp GRAVE      &kp SLASH       &kp UNDER             &kp MINUS  &kp PLUS               &kp STAR
                                               &trans             &trans         &trans         &trans          &trans                &trans
            >;
        };

        wm {
            display-name = "WM";
            bindings = <
                &kp LA(Q)  &kp LA(W)  &kp LA(F)  &kp LA(P)    &kp LA(B)    &kp LA(J)       &kp LA(J)  &kp LA(U)      &kp LA(Y)       &trans
                &kp LA(A)  &kp LA(R)  &kp LA(S)  &kp LA(T)    &kp LA(G)    &kp LA(M)       &kp LA(N)  &kp LA(E)      &kp LA(I)       &kp LA(O)
                &kp LA(Z)  &kp LA(X)  &kp LA(C)  &kp LA(D)    &kp LA(V)    &kp LA(K)       &kp LA(H)  &kp LA(COMMA)  &kp LA(PERIOD)  &trans
                                      &trans     &bootloader  &trans       &kp LEFT_SHIFT  &trans     &trans
            >;
        };

        mouse {
            display-name = "MOU";
            bindings = <
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &drag_on &trans   &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans  &trans    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans  &trans    &trans  &trans  &trans
            >;
        };

        numbers {
            display-name = "NUM";
            bindings = <
                &kp KP_N1  &kp KP_N2  &kp KP_N3  &kp KP_N4  &kp KP_N5    &kp KP_N6  &kp KP_N7  &kp KP_N8  &kp KP_N9  &trans
                &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans
                &trans     &trans     &trans     &trans     &trans       &trans     &trans     &trans     &trans     &trans
                                      &trans     &trans     &trans       &trans     &trans     &trans
            >;
        };

        adj {
            display-name = "ADJ";
            bindings = <
                &trans          &kp F7  &kp F8    &kp F9  &kp F12      &kp C_VOL_DN  &kp C_MUTE    &kp C_VOL_UP  &trans        &trans
                &trans          &kp F4  &kp F5    &kp F6  &kp F11      &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &studio_unlock  &kp F1  &kp F2    &kp F3  &kp F10      &trans        &trans        &trans        &trans        &trans
                                        &kp LGUI  &trans  &kp SPACE    &kp ENTER     &trans        &kp RALT
            >;
        };

        drag {
            display-name = "DRAG";
            bindings = <
                &trans  &trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &drag_off &trans    &trans  &trans  &trans  &trans  &trans
                &trans  &trans  &trans  &trans    &trans    &trans  &trans  &trans  &trans  &trans
                                &trans  &trans    &trans    &trans  &trans  &trans
            >;
        };

        extra_2 {
            status = "reserved";
        };

        extra_3 {
            status = "reserved";
        };
    };
};
